.custom-nav {
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
}

.fixed {
  position: fixed;
}

.shadow {
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
}

.nav-left {
  width: 100rpx;
  min-width: 100rpx;
  display: flex;
  align-items: center;
}

/* 右槽避让胶囊（约 87px 宽 + 边距），槽内容右对齐到胶囊左侧 */
.nav-right {
  width: 200rpx;
  min-width: 200rpx;
  display: flex;
  align-items: center;
}

.nav-left.narrow {
  width: 32rpx;
  min-width: 32rpx;
}

.nav-right {
  justify-content: flex-end;
  /* 内容右缘停在胶囊左侧（胶囊约 87px 宽 + 4px 边距） */
  margin-right: 180rpx;
}

/* 44pt 命中区：88rpx。nav-bar 高度锁 44px，溢出部分透明可点，不影响排版 */
.nav-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid;
  border-bottom: 4rpx solid;
  transform: rotate(45deg);
}

.home-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-title.left {
  text-align: left;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* v2 首页大标题：24px / 650 / 收紧字距 */
.nav-title.big {
  font-size: 48rpx;
  font-weight: 650;
  letter-spacing: -1.2rpx;
}
