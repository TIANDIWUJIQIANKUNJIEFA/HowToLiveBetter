.article-card {
  position: relative;
  display: flex;
  background: var(--color-surface, #ffffff);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

/* horizontal layout */
.horizontal {
  flex-direction: row;
  padding: 24rpx;
  align-items: center;
}

.horizontal .article-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--color-placeholder, #eef0f0);
}

.horizontal .article-content {
  flex: 1;
  margin-left: 24rpx;
  /* 让出星标 88rpx 命中区（右缘 4 + 宽 88），避免透明区域压住可点文字 */
  margin-right: 92rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

/* vertical layout */
.vertical {
  flex-direction: column;
}

.vertical .article-cover {
  width: 100%;
  height: 240rpx;
}

.vertical .article-content {
  padding: 24rpx;
}

/* 分类名：文字用中性色保证可读，颜色识别交给左侧色点（8 个分类色中 6 个做文字不达标） */
.article-category {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #5b616a);
  margin-bottom: 8rpx;
}

.category-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.article-category-below {
  font-size: 24rpx;
  color: var(--color-text-secondary, #5b616a);
  margin-bottom: 12rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #22262b);
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.article-summary {
  font-size: 24rpx;
  color: var(--color-text-secondary, #5b616a);
  line-height: 1.5;
  max-height: 72rpx;
  overflow: hidden;
}

.star-btn {
  position: absolute;
  /* 视觉 40rpx 不变，盒子 88rpx 撑足 44pt 命中区 */
  right: 4rpx;
  top: calc(50% - 44rpx);
  width: 88rpx;
  height: 88rpx;
  padding: 24rpx;
}

.star-btn.pop {
  animation: star-pop 0.3s ease;
}

@keyframes star-pop {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
  }
}

/* 分类色点在深色卡上亮度不足，补一圈极淡描边保证可见 */
@media (prefers-color-scheme: dark) {
  .category-dot {
    box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.18);
  }
}
