@import "../../styles/variables-v2.wxss";

.page {
  min-height: 100vh;
  background: var(--lb-bg);
  padding: 8rpx 36rpx 72rpx;
  box-sizing: border-box;
}

/* ---------- 分组（设计稿 20：help-sec / ht / p） ---------- */
.help-sec { margin-bottom: 36rpx; }
.ht {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--lb-ink);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ht::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--lb-brand);
}
.hp {
  font-size: 24rpx;
  color: var(--lb-ink2);
  line-height: 1.9;
  padding-left: 24rpx;
  margin-bottom: 6rpx;
}
