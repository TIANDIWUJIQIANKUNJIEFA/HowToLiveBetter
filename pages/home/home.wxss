.home-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.home-content {
  padding: 8rpx 32rpx 48rpx;
}

/* ---------- 顶部状态行 ---------- */
/* 色值取自设计稿原图：chip 是白底绿字绿点（#42B45B / #F3F5F4），
   不是全局变量的浅绿底，故此处单独写 */
.status-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round, 999px);
  /* 白字 4.91:1；原 #42b45b 只有 2.65:1 */
  background: #357f45;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  margin-right: 10rpx;
}

.status-chip-text {
  font-size: var(--font-size-sm, 24rpx);
  font-weight: 500;
  color: #ffffff;
}

.status-total {
  margin-left: 20rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-secondary);
}

/* ---------- 调研入口 hero ---------- */
.hero-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 36rpx 0 36rpx 32rpx;
  border-radius: var(--radius-lg, 24rpx);
  /* 色值取自设计稿 green-life-2026-10-11 原图采样：
     左侧纯背景 #55B162，右侧插画旁 #C2E6C0，纵向几乎无变化 → 135° 线性渐变 */
  background: linear-gradient(135deg, #55B162 0%, #86CB8E 55%, #C2E6C0 100%);
  /* 设计图里这张卡几乎没有投影，只有一道很淡的绿调边缘 */
  box-shadow: 0 4rpx 16rpx rgba(85, 177, 98, 0.14);
  margin-bottom: 44rpx;
  overflow: hidden;
}

.hero-body {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.hero-title {
  display: block;
  font-size: var(--font-size-xxl, 48rpx);
  font-weight: 700;
  /* 深绿字在浅绿渐变上 4.98–9.75:1；白字最浅处仅 1.37:1 */
  color: #14361f;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  padding-right: 16rpx;
  font-size: var(--font-size-base, 28rpx);
  /* 渐变最深处（#55B162）上也有 4.98:1；半透明版只有 4.07 */
  color: #14361f;
  line-height: 1.5;
}

/* 3D 人物插画：设计稿右侧，右下贴边 */
/* 设计图里人物从卡顶贯穿到卡底，宽约占卡宽 31%、高约 90%。
   图片已 trim 掉透明留白（240×300 → 217×260，比例 0.835），
   容器比例必须 ≥ 图片比例，否则 aspectFit(contain) 会裁掉两侧。 */
.hero-art {
  width: 246rpx;
  height: 294rpx;
  flex-shrink: 0;
  margin-right: -10rpx;
  margin-bottom: -46rpx;
}

.hero-action {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 14rpx 32rpx;
  border-radius: var(--radius-round, 999px);
  /* 设计图按钮是纯白底 + 品牌绿字，色值同样取自原图采样 */
  background: #ffffff;
}

.hero-action-text {
  font-size: var(--font-size-md, 30rpx);
  font-weight: 600;
  color: #247a55;
}

.hero-action-arrow {
  margin-left: 10rpx;
  font-size: var(--font-size-md, 30rpx);
  font-weight: 600;
  color: #247a55;
}

/* ---------- 搜索 ---------- */
.search-bar {
  margin-bottom: 32rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: var(--color-surface);
  border-radius: var(--radius-round, 999px);
  padding: 0 28rpx;
  box-shadow: 0 2rpx 12rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
}

.search-input::placeholder {
  color: var(--color-text-tertiary);
}

/* 微信端 placeholder 用 placeholder-class 更可靠，与上面的伪元素同色 */
.search-placeholder {
  color: var(--color-text-tertiary);
}

/* 44pt 命中区：88rpx。内边距 28 让图标保持 32rpx，右缘位置不变 */
.clear-btn {
  width: 88rpx;
  height: 88rpx;
  padding: 28rpx;
  margin-right: -8rpx;
  flex-shrink: 0;
}

/* 搜索结果 */
.search-results {
  min-height: 600rpx;
}

.result-item {
  margin-bottom: 24rpx;
}

.no-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 48rpx;
}

.no-result-text {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.no-result-action {
  margin-top: 24rpx;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  background: var(--color-primary-light);
  /* 原 primary 压浅绿底仅 2.8:1，改用深一档的 ink */
  color: var(--color-primary-ink);
  font-size: 27rpx;
}

.result-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 12rpx;
}

.result-more-text {
  color: var(--color-primary-ink);
  font-size: 26rpx;
}

.result-more-arrow {
  margin-left: 6rpx;
  color: var(--color-primary-ink);
  font-size: 30rpx;
}

/* ---------- 区块 ---------- */
.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-lg, 32rpx);
  font-weight: 600;
  color: var(--color-text);
}

.section-more {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-secondary);
  /* 44pt 命中区：上下外扩，负 margin 抵消排版位移 */
  padding: 24rpx 8rpx;
  margin: -24rpx -8rpx;
}

.section-sub {
  display: block;
  margin-top: -8rpx;
  margin-bottom: 20rpx;
  font-size: var(--font-size-xs, 22rpx);
  color: var(--color-text-tertiary);
}

/* 探索分类：4 列宫格
   首列图标左缘、末列图标右缘与内容边距（32rpx）对齐：
   grid 锁死 4 列（每列 96rpx），space-between 撑开贴边；
   不用 flex-wrap（item 变窄后一行会塞进 7 个） */
.tile-grid {
  display: grid;
  grid-template-columns: repeat(4, 120rpx);
  justify-content: space-between;
}

.tile-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.tile-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.tile-glyph {
  width: 60rpx;
  height: 60rpx;
}

.tile-name {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text);
  white-space: nowrap;
}

/* 今日更新 */
.update-list {
  background: var(--color-surface);
  border-radius: var(--radius-lg, 24rpx);
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.update-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.update-item:last-child {
  border-bottom: none;
}

/* 左侧封面缩略图 */
.update-cover {
  width: 168rpx;
  height: 132rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: var(--color-placeholder);
}

.update-main {
  flex: 1;
  min-width: 0;
}

/* 标签 + 标题同一行 */
.update-title-row {
  display: flex;
  align-items: flex-start;
}

/* 标签底色取自设计稿原图采样（#A0DCBE），文字压深到达标色 #1F5C3D */
.update-tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  /* 与标题首行视觉对齐（标题行高 42rpx，标签 35rpx） */
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #a0dcbe;
  font-size: var(--font-size-xs, 22rpx);
  line-height: 1.6;
  color: #1f5c3d;
}

/* 「更新」用中性灰，避免和「新增」抢眼 */
.update-tag.update {
  background: var(--color-placeholder);
  color: var(--color-text-secondary);
}

.update-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-md, 30rpx);
  font-weight: 500;
  color: var(--color-text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.update-brief {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.update-meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-size-xs, 22rpx);
  color: var(--color-text-tertiary);
}

.update-arrow {
  margin-left: 16rpx;
  font-size: 32rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.update-empty {
  padding: 48rpx 0;
  text-align: center;
}

.update-empty-text {
  font-size: var(--font-size-base, 28rpx);
  color: var(--color-text-secondary);
}

/* ---------- 深色模式 ----------
   上面的色值是照设计稿（浅色）采样的。深色下：
   · hero 渐变压深一档，否则白字在 #56a869 上只有 2.92:1
   · 深色下文字回到白色（浅色用的是深绿字）
   · chip 底色和「新增」标签的浅绿底在#15171a 上会刺眼，改成低透明度叠加 */
@media (prefers-color-scheme: dark) {
  .hero-card {
    background: linear-gradient(135deg, #2e6b3b 0%, #317239 55%, #357a45 100%);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.36);
  }

  /* 白字在深绿渐变上 5.22–6.40:1 */
  .hero-title {
    color: #ffffff;
  }

  .hero-desc {
    color: rgba(255, 255, 255, 0.92);
  }

  .hero-title,
  .hero-desc {
    text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
  }

  .status-chip {
    background: #357f45;
  }

  .update-tag {
    background: rgba(92, 180, 118, 0.18);
    color: #7cc795;
  }
}
