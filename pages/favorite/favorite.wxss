@import "../../styles/variables-v2.wxss";

/* ---------- 顶部三 tab（设计稿 15：建议 N / 章节 N / 主题 N） ---------- */
.lt-tabs {
  display: flex;
  gap: 44rpx;
  padding: 4rpx 32rpx 0;
  background: var(--lb-bg);
}
.lt {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--lb-ink3);
  padding: 20rpx 4rpx;
  position: relative;
}
.lt.on { color: var(--lb-ink); }
.lt.on::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--lb-brand);
}

.page { padding: 16rpx 36rpx 56rpx; background: var(--lb-bg); min-height: 100vh; box-sizing: border-box; }

/* ---------- 收藏卡 ---------- */
.minor {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
}
.row-hover { opacity: .8; }
.mdot { width: 8rpx; height: 44rpx; border-radius: 6rpx; flex: none; margin-top: 10rpx; }
.mmain { flex: 1; min-width: 0; }
.mt { font-size: 28rpx; font-weight: 650; color: var(--lb-ink); line-height: 1.55; }
.mp {
  font-size: 24rpx; color: var(--lb-ink2); line-height: 1.75; margin-top: 8rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.mm { font-size: 20rpx; color: var(--lb-ink3); margin-top: 10rpx; }
.star { color: var(--lb-brand); font-size: 34rpx; flex: none; padding: 0 4rpx; }
.chev { width: 30rpx; height: 30rpx; opacity: .5; flex: none; align-self: center; }

.go { color: var(--lb-brand-ink); margin-top: 16rpx; }
