<custom-nav title="收藏" align="left" big="{{true}}" bg-color="var(--lb-bg, #F6F5F0)" shadow="{{false}}"></custom-nav>

<view class="lt-tabs">
  <view class="lt {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key"
        data-tab="{{item.key}}" bindtap="onTab">{{item.label}} {{item.count}}</view>
</view>

<view class="page">
  <!-- 建议 -->
  <block wx:if="{{tab === 'step'}}">
    <view class="minor lb-card" wx:for="{{steps}}" wx:key="uid"
          data-book="{{item.bookId}}" data-chapter="{{item.chapterId}}"
          data-index="{{item.index}}" bindtap="onStepTap" hover-class="row-hover">
      <view class="mdot" style="background:{{item.accent}}"></view>
      <view class="mmain">
        <view class="mt">{{item.title}}</view>
        <view class="mp" wx:if="{{item.plain}}">{{item.plain}}</view>
        <view class="mm">{{item.bookTitle}} · {{item.chapterTitle}} · NO.{{item.noLabel}}<text wx:if="{{item.favDays}}"> · 已收藏 {{item.favDays}}</text></view>
      </view>
      <text class="star" catchtap="onUnfav" data-uid="{{item.uid}}">★</text>
    </view>
    <view wx:if="{{!steps.length}}" class="lb-empty">
      还没有收藏的建议
      <view class="go" bindtap="goReco">去推荐页挑几条 ›</view>
    </view>
  </block>

  <!-- 章节 -->
  <block wx:if="{{tab === 'chapter'}}">
    <view class="minor lb-card" wx:for="{{chapters}}" wx:key="uid"
          data-book="{{item.bookId}}" data-chapter="{{item.chapterId}}" bindtap="onChapterTap" hover-class="row-hover">
      <view class="mdot" style="background:{{item.accent}}"></view>
      <view class="mmain">
        <view class="mt">{{item.title}}</view>
        <view class="mm lb-mono">{{item.bookTitle}}<text wx:if="{{item.brief}}"> · {{item.brief}}</text></view>
      </view>
      <image class="theme-icon-light chev" src="/assets/icons-v2/chev.png" mode="aspectFit" />
<image class="theme-icon-dark chev" src="/assets/icons-v2/dark/chev.png" mode="aspectFit" />
    </view>
    <view wx:if="{{!chapters.length}}" class="lb-empty">
      还没有收藏的章节
      <view class="go" bindtap="goLibrary">去书库逛逛 ›</view>
    </view>
  </block>

  <!-- 主题 -->
  <block wx:if="{{tab === 'topic'}}">
    <view class="minor lb-card" wx:for="{{topics}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onTopicTap" hover-class="row-hover">
      <view class="mmain">
        <view class="mt">{{item.name}}</view>
        <view class="mm lb-mono">{{item.count}} 章</view>
      </view>
      <image class="theme-icon-light chev" src="/assets/icons-v2/chev.png" mode="aspectFit" />
<image class="theme-icon-dark chev" src="/assets/icons-v2/dark/chev.png" mode="aspectFit" />
    </view>
    <view wx:if="{{!topics.length}}" class="lb-empty">
      还没有收藏的主题，在主题聚合页点 ★ 收藏
    </view>
  </block>
</view>
