@import "../../styles/variables-v2.wxss";

/* 暖瓷白 × 松石绿 · 我的页，按确认效果图落地 */
page { background: var(--lb-bg); }
.mine-page { padding: 8rpx 36rpx 40rpx; background: var(--lb-bg); min-height: 100vh; box-sizing: border-box; }
.ucard { display: flex; align-items: center; gap: 24rpx; padding: 32rpx 28rpx; margin-top: 16rpx; min-height: 188rpx; background: var(--lb-hero-bg); border: 0; }
.uav-wrap { position: relative; width: 124rpx; height: 124rpx; flex: none; }
.uav { display: block; width: 124rpx; height: 124rpx; border-radius: 50%; flex: none; background: #D6E4DB; }
.uinfo { flex: 1; min-width: 0; }
.un { display: block; font-size: 32rpx; font-weight: 650; line-height: 1.5; color: var(--lb-ink); overflow-wrap: break-word; }
.ub { display: block; font-size: 20rpx; line-height: 1.7; color: var(--lb-ink2); margin-top: 8rpx; }
/* 编辑图标 32px 视觉圆片，保留 44px 命中区 */
.uedit { width: 88rpx; height: 88rpx; margin-left: -8rpx; margin-right: -16rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.uedit-surface { width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(255,253,249,0.65); display: flex; align-items: center; justify-content: center; }
.uedit-ico { width: 36rpx; height: 36rpx; }
.icon-light { display: block; }
.icon-dark { display: none; }

/* 三列统计：保持真实收藏、历史、在读数据 */
.ustats { display: flex; gap: 16rpx; margin: 24rpx 0; }
.ustats .s { flex: 1; min-width: 0; padding: 24rpx 8rpx 22rpx; min-height: 144rpx; text-align: center; }
.ustats .v { font-family: inherit; font-size: 46rpx; font-weight: 600; line-height: 1.2; color: var(--lb-ink); font-variant-numeric: tabular-nums; }
.ustats .k { font-size: 21rpx; color: var(--lb-ink2); margin-top: 12rpx; }

/* 整体菜单面板：面板描边，行间细分隔线 */
.menu { padding: 0 24rpx; overflow: hidden; }
.menu .row { display: flex; align-items: center; gap: 24rpx; padding: 22rpx 0; min-height: 100rpx; position: relative; }
.menu .row + .row { border-top: 1rpx solid var(--lb-line); }
.row-hover { opacity: 0.75; }
.mi { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--lb-brand-bg); display: flex; align-items: center; justify-content: center; flex: none; }
.mi-ico { width: 40rpx; height: 40rpx; }
.mm2 { flex: 1; min-width: 0; }
.ml { display: block; font-size: 27rpx; line-height: 1.5; font-weight: 500; color: var(--lb-ink); }
.md { display: block; font-size: 20rpx; color: var(--lb-ink2); margin-top: 4rpx; line-height: 1.6; }
.md-updated { margin-top: 0; font-size: 19rpx; color: var(--lb-ink3); font-variant-numeric: tabular-nums; }
.ar { width: 28rpx; height: 28rpx; flex: none; }
.ar-ico { width: 100%; height: 100%; }
/* 保留原生客服按钮，整行可点击 */
.row-contact { overflow: hidden; }
.contact-cover { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0; }

.follow-section { margin-top: 24rpx; }
.follow-card { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 24rpx; min-height: 124rpx; }
.follow-card .ml { font-size: 26rpx; }
.follow-card .md { font-size: 19rpx; }
.go { font-size: 23rpx; font-weight: 600; color: var(--lb-brand-ink); flex: none; }
@media (prefers-color-scheme: dark) {
  .uav { background: #405747; }
  .uedit-surface { background: rgba(255,253,249,0.07); }
  .icon-light { display: none; }
  .icon-dark { display: block; }
}
@media (max-width: 350px) {
  .ucard { padding: 28rpx 24rpx; gap: 20rpx; }
  .uav-wrap { width: 112rpx; height: 112rpx; }
  .uav { width: 112rpx; height: 112rpx; }
  .ub { font-size: 19rpx; }
}

/* 头像会员角标：视觉小徽章，独立保留 44px 触控区域。 */
.vip-avatar-button {
  position: absolute; left: 50%; bottom: -30rpx; transform: translateX(-50%);
  width: 148rpx; height: 88rpx; min-height: 44px;
  display: flex; align-items: center; justify-content: center;
  padding: 0; margin: 0; background: transparent; border: 0; line-height: 1;
}
.vip-avatar-button::after { border: 0; }
.vip-badge {
  display: inline-flex; align-items: center; justify-content: center; gap: 6rpx;
  min-width: 106rpx; height: 44rpx; padding: 0 14rpx;
  border-radius: 999rpx; border: 2rpx solid var(--lb-line);
  background: var(--lb-surface); color: var(--lb-ink2);
  font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx;
  box-shadow: 0 3rpx 8rpx rgba(23,32,28,.08);
}
.vip-badge.is-active { background: var(--lb-orange); border-color: var(--lb-orange); color: var(--lb-on-brand); }
.vip-crown { width: 24rpx; height: 24rpx; flex: none; }
