@import "../../styles/variables-v2.wxss";

page { background: var(--lb-bg); color: var(--lb-ink); }

.result-page {
  min-height: 100vh;
  background: var(--lb-bg);
}

.result-content {
  padding: 32rpx 32rpx 64rpx;
}

/* 匹配中 */
.generating {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx;
}

.gen-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 8rpx solid var(--lb-brand-bg);
  border-top-color: var(--lb-brand);
  animation: gen-spin 0.9s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes gen-spin {
  to { transform: rotate(360deg); }
}

.gen-title {
  font-size: var(--font-size-lg, 32rpx);
  font-weight: 600;
  color: var(--lb-ink);
}

.gen-desc {
  margin-top: 12rpx;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink2);
}

/* 引导空态 */
.empty-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 56rpx;
  background: var(--lb-surface);
  border-radius: var(--lb-r-card);
  border: 1rpx solid var(--lb-line);
}

.guide-title {
  font-size: var(--font-size-xl, 36rpx);
  font-weight: 700;
  color: var(--lb-ink);
}

.guide-desc {
  margin-top: 16rpx;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink2);
  line-height: 1.5;
  text-align: center;
}

.guide-sub {
  margin-top: 40rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--lb-ink2);
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  margin-top: 32rpx;
  border-radius: var(--lb-r-btn);
  background: var(--lb-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-md, 30rpx);
  font-weight: 600;
  color: var(--lb-on-brand);
}

/* 区块 */
.section {
  margin-top: 40rpx;
}

.section-title {
  display: block;
  font-size: var(--font-size-lg, 32rpx);
  font-weight: 600;
  color: var(--lb-ink);
  margin-bottom: 20rpx;
}

/* 匹配依据 */
.summary-card {
  padding: 28rpx 28rpx;
  border-radius: var(--lb-r-card);
  background: var(--lb-brand-bg);
}

.summary-label {
  display: block;
  font-size: var(--font-size-xs, 22rpx);
  color: var(--lb-brand-ink);
  margin-bottom: 10rpx;
}

.summary-text {
  display: block;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink);
  line-height: 1.55;
}

/* 首选建议 */
.top-card {
  padding: 32rpx 32rpx 28rpx;
  border-radius: var(--lb-r-card);
  background: var(--lb-surface);
  border: 1rpx solid var(--lb-line);
}

.top-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.top-percent {
  font-size: var(--font-size-sm, 24rpx);
  font-weight: 600;
  color: var(--lb-brand-ink);
}

.grade-badge {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--lb-brand-bg);
  color: var(--lb-brand-ink);
  font-size: var(--font-size-xs, 22rpx);
}

.top-title {
  display: block;
  font-size: var(--font-size-xl, 36rpx);
  font-weight: 700;
  color: var(--lb-ink);
  line-height: 1.45;
}

.top-plain {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink2);
  line-height: 1.65;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.chip {
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: var(--lb-r-btn);
  background: var(--lb-surface2);
  font-size: var(--font-size-xs, 22rpx);
  color: var(--lb-ink);
}

.top-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--lb-line);
}

.top-from {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--lb-ink2);
}

.top-link {
  font-size: var(--font-size-sm, 24rpx);
  color: var(--lb-brand-ink);
}

/* 其他建议 */
.minor-card {
  padding: 26rpx 28rpx;
  border-radius: var(--lb-r-card);
  background: var(--lb-surface);
  border: 1rpx solid var(--lb-line);
  margin-bottom: 20rpx;
}

.minor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.minor-title {
  flex: 1;
  font-size: var(--font-size-md, 30rpx);
  font-weight: 600;
  color: var(--lb-ink);
  line-height: 1.45;
}

.minor-percent {
  margin-left: 16rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--lb-brand-ink);
}

.minor-plain {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink2);
  line-height: 1.6;
}

.minor-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.minor-from {
  font-size: var(--font-size-xs, 22rpx);
  color: var(--lb-ink2);
}

.minor-grade {
  font-size: var(--font-size-xs, 22rpx);
  color: var(--lb-ink2);
}

/* 底部 */
.result-actions {
  display: flex;
  margin-top: 40rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  margin-right: 20rpx;
  border-radius: var(--lb-r-btn);
  background: var(--lb-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink);
}

.btn-ghost:last-child {
  margin-right: 0;
}

.disclaimer {
  display: block;
  margin-top: 32rpx;
  font-size: var(--font-size-xs, 22rpx);
  color: var(--lb-ink2);
  line-height: 1.6;
}

/* ---------- 分享解锁：未解锁时结果打码 + 居中浮层 ---------- */
.result-body.is-locked {
  filter: blur(14rpx);
  pointer-events: none;
}

.share-lock {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: var(--lb-bg);
}

.lock-card {
  width: 100%;
  max-width: 560rpx;
  padding: 56rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--lb-surface);
  border-radius: 32rpx;
  border: 1rpx solid var(--lb-line);
}

.lock-title {
  font-size: var(--font-size-lg, 34rpx);
  font-weight: 700;
  color: var(--lb-ink);
  text-align: center;
  line-height: 1.4;
}

.lock-desc {
  margin-top: 20rpx;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink2);
  text-align: center;
  line-height: 1.65;
}

.lock-share-btn {
  margin-top: 44rpx;
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: var(--lb-r-btn);
  background: var(--lb-brand);
  color: var(--lb-on-brand);
  font-size: var(--font-size-md, 30rpx);
  font-weight: 600;
}

.lock-share-btn::after {
  border: none;
}

.lock-cancel {
  margin-top: 28rpx;
  font-size: var(--font-size-base, 28rpx);
  color: var(--lb-ink2);
}
