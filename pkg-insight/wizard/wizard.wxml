<custom-nav title="挑选建议" back="{{true}}" custom-back="{{true}}" bind:back="onNavBack" bg-color="var(--lb-bg, #F6F5F0)" text-color="var(--lb-ink, #242E2B)" shadow="{{false}}"></custom-nav>

<view class="page">
  <!-- 步骤进度 -->
  <view class="wz-prog">
    <view class="bar {{step >= 1 ? 'on' : ''}}"></view>
    <view class="bar {{step >= 2 ? 'on' : ''}}"></view>
  </view>

  <view wx:if="{{sourceCount}}" class="source-note">从 {{sourceCount}} 本已上架指南中挑选 · {{sourceSteps}} 条建议</view>

  <!-- 第 1 步：选一个方向（自动进入下一步） -->
  <block wx:if="{{step === 1}}">
    <view class="wz-h">
      <view class="st2">想先改善哪方面？</view>
      <view class="ss">选一个就进入下一步，也可以随时返回</view>
    </view>
    <view class="opts">
      <view class="opt {{sel === item.id ? 'on' : ''}}"
            wx:for="{{topics}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onTopic" hover-class="opt-hover">
        <view class="oi"><image class="oi-img theme-icon-light" src="{{item.icon}}" mode="aspectFit" /><image class="oi-img theme-icon-dark" src="{{item.darkIcon}}" mode="aspectFit" /></view>
        <view class="om">
          <view class="ot">{{item.short}}</view>
          <view class="od">{{item.desc}}</view>
        </view>
        <view class="ok {{sel === item.id ? 'on' : ''}}">✓</view>
      </view>
    </view>
    <view class="disclaim">第 1 步 · 共 2 步 · 选中自动进入下一步</view>
  </block>

  <!-- 第 2 步：时间预算 + 障碍 -->
  <block wx:if="{{step === 2}}">
    <view class="wz-h">
      <view class="st2">能投入多少时间？</view>
      <view class="ss">决定先给「顺手就能做」的还是需要投入的</view>
    </view>
    <view class="opts opts-gap">
      <view class="opt {{budget === item.id ? 'on' : ''}}"
            wx:for="{{budgets}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onBudget" hover-class="opt-hover">
        <view class="om">
          <view class="ot">{{item.label}}</view>
          <view class="od">{{item.desc}}</view>
        </view>
        <view class="ok {{budget === item.id ? 'on' : ''}}">✓</view>
      </view>
    </view>

    <view class="wz-h wz-h2">
      <view class="st2 st2-sm">最大的障碍是？</view>
      <view class="ss">可多选，也可以跳过</view>
    </view>
    <view class="tps">
      <view class="chip {{item.selected ? 'on' : ''}}"
            wx:for="{{obstacles}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onObstacle">{{item.label}}</view>
    </view>

    <view class="btn" bindtap="onSubmit" hover-class="btn-hover">生成我的建议</view>
    <view class="disclaim">在线推荐会使用所选方向、时间预算、障碍和匿名标识；断网时使用本地推荐。</view>
  </block>
</view>
