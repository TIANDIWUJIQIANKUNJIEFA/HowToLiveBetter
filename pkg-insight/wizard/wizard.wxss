@import "../../styles/variables-v2.wxss";

.page {
  padding: 8rpx 36rpx 56rpx;
  background: var(--lb-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 步骤进度 ---------- */
.wz-prog {
  display: flex;
  gap: 12rpx;
  margin: 32rpx 0 8rpx;
}
.wz-prog .bar {
  height: 8rpx;
  flex: 1;
  border-radius: 4rpx;
  background: var(--lb-line);
}
.wz-prog .bar.on { background: var(--lb-brand); }

/* ---------- 标题区 ---------- */
.wz-h { padding: 12rpx 0 8rpx; }
.wz-h .st2 {
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  color: var(--lb-ink);
}
.wz-h .st2-sm { font-size: 36rpx; }
.wz-h .ss {
  font-size: 24rpx;
  color: var(--lb-ink2);
  margin-top: 12rpx;
}
.wz-h2 { margin-top: 44rpx; }

/* ---------- 选项列表 ---------- */
.opts { margin-top: 28rpx; }
.opts-gap { margin: 28rpx 0 44rpx; }
.opt {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 28rpx;
  border: 3rpx solid var(--lb-line);
  border-radius: var(--lb-r-card);
  background: var(--lb-surface);
  margin-bottom: 20rpx;
}
.opt-hover { opacity: .85; }
.opt .oi {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--lb-surface2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.oi-img { width: 38rpx; height: 38rpx; }
.opt .om { flex: 1; min-width: 0; }
.opt .ot {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--lb-ink);
}
.opt .od {
  font-size: 22rpx;
  color: var(--lb-ink2);
  margin-top: 4rpx;
}
.opt .ok {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--lb-line);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}
.opt.on {
  border-color: var(--lb-brand);
  background: var(--lb-brand-bg);
}
.opt.on .oi { background: var(--lb-surface); }
.opt.on .ok {
  background: var(--lb-brand);
  border-color: var(--lb-brand);
}

/* ---------- 障碍 chips ---------- */
.tps {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  min-height: 76rpx;
  padding: 16rpx 26rpx;
  font-size: 25rpx;
  border: 1rpx solid var(--lb-line);
  border-radius: var(--lb-r-chip);
  color: var(--lb-ink);
  background: var(--lb-surface);
}
.chip.on {
  background: var(--lb-brand);
  border-color: var(--lb-brand);
  color: var(--lb-on-brand);
  font-weight: 700;
}

/* ---------- 主按钮 ---------- */
.btn {
  margin-top: 52rpx;
  padding: 28rpx;
  border-radius: var(--lb-r-btn);
  background: var(--lb-brand);
  color: var(--lb-on-brand);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.btn-hover { opacity: .88; }

/* ---------- 底部说明 ---------- */
.disclaim {
  font-size: 21rpx;
  color: var(--lb-ink3);
  line-height: 1.8;
  text-align: center;
  margin-top: 36rpx;
}

.source-note { margin: 20rpx 0 8rpx; color: var(--lb-brand-ink); font-size: 22rpx; line-height: 1.7; }
