{
  "pages": [
    "pages/reco/reco",
    "pages/library/library",
    "pages/favorite/favorite",
    "pages/mine/mine",
    "pages/book-detail/book-detail",
    "pages/topic-aggregate/topic-aggregate",
    "pages/index/index",
    "pages/home/home",
    "pages/classify/classify"
  ],
  "subpackages": [
    {
      "root": "pkg-read",
      "name": "read",
      "pages": [
        "chapter-read/chapter-read",
        "search/search",
        "daily/daily",
        "download/download",
        "help/help",
        "about/about",
        "webview/webview"
      ]
    },
    {
      "root": "pkg-insight",
      "name": "insight",
      "pages": [
        "wizard/wizard",
        "result/result",
        "vip/vip",
        "account/account"
      ]
    },
    {
      "root": "pagesA",
      "name": "content-legacy",
      "pages": [
        "category-detail/category-detail",
        "article/article",
        "daily/daily",
        "search/search",
        "download/download",
        "help/help",
        "about/about",
        "webview/webview"
      ]
    },
    {
      "root": "pagesB",
      "name": "insight-legacy",
      "pages": [
        "survey/survey",
        "survey-result/survey-result"
      ]
    }
  ],
  "preloadRule": {
    "pages/reco/reco": {
      "network": "all",
      "packages": [
        "read",
        "insight"
      ]
    }
  },
  "window": {
    "navigationStyle": "custom",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "enablePullDownRefresh": false,
    "navigationBarTextStyle": "@navTextStyle"
  },
  "tabBar": {
    "custom": false,
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/reco/reco",
        "text": "为我推荐",
        "iconPath": "@sparkIcon",
        "selectedIconPath": "@sparkSelectedIcon"
      },
      {
        "pagePath": "pages/library/library",
        "text": "书库",
        "iconPath": "@booksIcon",
        "selectedIconPath": "@booksSelectedIcon"
      },
      {
        "pagePath": "pages/favorite/favorite",
        "text": "收藏",
        "iconPath": "@bmkIcon",
        "selectedIconPath": "@bmkSelectedIcon"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "@userIcon",
        "selectedIconPath": "@userSelectedIcon"
      }
    ]
  },
  "usingComponents": {
    "custom-nav": "/components/custom-nav/custom-nav",
    "article-card": "/components/article-card/article-card",
    "article-list": "/components/article-list/article-list",
    "loading": "/components/loading/loading",
    "empty-state": "/components/empty-state/empty-state"
  },
  "sitemapLocation": "sitemap.json",
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "requiredBackgroundModes": []
}
